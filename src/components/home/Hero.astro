---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import Swash from '../Swash.astro';
import { enquiryHref, events, featured } from '../../data/events';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap grid">
    <div class="copy">
      <p class="eyebrow">Smart photo booth for events</p>
      <h1 id="hero-title" class="display">
        Good times.<br />
        Ready to <span class="nowrap"><span class="word"><span class="accent">share</span><Swash /></span>.</span>
      </h1>
      <p class="lead">
        Guests start the booth with a gesture, strike a pose and find their photos in a live gallery on their
        phone. Download, share, done, while the night is still happening.
      </p>
      <div class="ctas">
        <a class="btn btn--green" href={enquiryHref}>Enquire now <Icon name="arrow-up-right" /></a>
        <a class="btn btn--ghost" href="#events">See past events</a>
      </div>
    </div>

    <div class="prints" aria-hidden="true">
      {featured.heroPrints.map((p, i) => (
        <figure class={`print p${i + 1}`}>
          <Image
            src={p.src}
            alt=""
            widths={[320, 480, 640, 960]}
            sizes="(min-width: 48rem) 34vw, 62vw"
            loading="eager"
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </figure>
      ))}
      <div class="sticker">
        <span>Live</span>
        <span>guest</span>
        <span>gallery</span>
      </div>
    </div>
  </div>

  <div class="wrap">
    <a class="recent" href="#events">
      <span class="faces" aria-hidden="true">
        {events.map((e) => (
          <Image src={e.cover.src} alt="" width={96} height={96} widths={[48, 96]} sizes="2.25rem" />
        ))}
      </span>
      <span class="recent-text">Recently at the <strong>NZIA 2026 Awards</strong> and two weddings</span>
      <Icon name="arrow-right" class="recent-arrow" />
    </a>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2rem, 1rem + 5vw, 5rem); overflow: clip; }
  .grid { display: grid; gap: clamp(3rem, 2rem + 4vw, 4rem); align-items: center; }

  .copy { display: grid; justify-items: start; gap: var(--space-lg); }
  .copy h1 { margin-top: var(--space-2xs); }
  .nowrap { white-space: nowrap; }
  .word { position: relative; display: inline-block; }
  .ctas { display: grid; gap: var(--space-sm); width: 100%; margin-top: var(--space-xs); }
  @media (min-width: 30rem) { .ctas { display: flex; flex-wrap: wrap; width: auto; } }

  /* Fanned stack of prints */
  .prints {
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 1 / 0.92;
    margin-inline: auto;
  }
  .print {
    position: absolute;
    width: 66%;
    transition: transform 700ms var(--ease-out);
    animation: print-in 1000ms var(--ease-out) both;
  }
  .p1 { left: 0; top: 4%; --r: -7deg; transform: rotate(var(--r)); animation-delay: 100ms; z-index: 1; }
  .p2 { right: 0; top: 0; --r: 5deg; transform: rotate(var(--r)); animation-delay: 220ms; z-index: 2; }
  .p3 { left: 16%; bottom: 0; --r: -1.5deg; transform: rotate(var(--r)); animation-delay: 340ms; z-index: 3; }
  @keyframes print-in {
    from { opacity: 0; transform: translateY(2rem) rotate(0deg) scale(0.96); }
    to { opacity: 1; transform: rotate(var(--r)); }
  }
  @media (hover: hover) {
    .prints:hover .p1 { transform: rotate(-10deg) translate(-4%, -2%); }
    .prints:hover .p2 { transform: rotate(8deg) translate(4%, -3%); }
    .prints:hover .p3 { transform: rotate(-0.5deg) translateY(3%); }
  }

  .sticker {
    position: absolute;
    z-index: 4;
    right: 2%;
    bottom: 12%;
    display: grid;
    place-content: center;
    width: clamp(5.25rem, 4rem + 5vw, 7rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    font-size: clamp(0.75rem, 0.6rem + 0.5vw, 0.9rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(12deg);
    box-shadow: var(--shadow-soft);
    animation: sticker-in 700ms var(--ease-out) 800ms both;
  }
  .sticker span:first-child {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    text-transform: none;
    font-size: 1.65em;
    line-height: 0.9;
  }
  @keyframes sticker-in { from { opacity: 0; transform: rotate(-20deg) scale(0.6); } }

  /* Recently at: one quiet line of proof */
  .recent {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: clamp(3rem, 2.5rem + 3vw, 5rem);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-decoration: none;
  }
  .recent strong { color: var(--ink); font-weight: 600; }
  .faces { display: flex; flex: none; }
  .faces :global(img) {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--paper);
  }
  .faces :global(img + img) { margin-left: -0.6rem; }
  .recent :global(.recent-arrow) { width: 1.1rem; height: 1.1rem; flex: none; color: var(--clay); transition: transform 300ms var(--ease-out); }
  .recent:hover :global(.recent-arrow) { transform: translateX(3px); }
  .recent:hover .recent-text { text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 0.25em; }

  @media (min-width: 48rem) {
    .grid { grid-template-columns: 1.25fr 1fr; }
    .prints { width: 100%; }
  }
</style>

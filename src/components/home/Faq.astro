---
import { enquiryHref } from '../../data/events';

const faqs = [
  {
    q: 'What do you need from the venue?',
    a: 'Just power and Wi-Fi. The booth is lightweight and easy to bring into any venue.',
  },
  {
    q: 'How do guests use the booth?',
    a: 'A simple gesture starts it. Guests pose, the booth takes the photo, and that’s it. No one needs to learn anything.',
  },
  {
    q: 'How do guests get their photos?',
    a: 'Photos appear in the live guest gallery as soon as they’re taken. Guests scan the QR code at the booth to find them, download their favourites and share them from their phone.',
  },
  {
    q: 'Can we get edited photos after the event?',
    a: 'Yes. We can provide professionally edited versions of your photos after the event.',
  },
  {
    q: 'What kinds of events do you do?',
    a: 'So far, awards nights and weddings. If you’re planning something else, tell us about it and we’ll see what fits.',
  },
  {
    q: 'How do we book?',
    a: 'Send us an email with the date, the venue and what you have in mind, and we’ll get back to you.',
  },
];
---
<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="head" data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="h2">Good <span class="accent">questions.</span></h2>
      <p>Can’t find what you’re after? <a class="text-link" href={enquiryHref}>Ask us directly</a>.</p>
    </div>

    <div class="list" data-reveal style="--reveal-delay:1">
      {faqs.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="toggle" aria-hidden="true"></span>
          </summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: var(--space-2xl); }
  .head { display: grid; gap: var(--space-md); align-content: start; }
  .head p:last-child { color: var(--ink-faint); }
  .head .text-link { padding-block: 0.6rem; }

  .list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: 1.35rem;
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: var(--leading-snug);
    list-style: none;
    cursor: pointer;
    border-radius: 4px;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .toggle { background: var(--ink); color: var(--paper); }
  .toggle {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    color: var(--ink);
    transition: background-color 200ms ease, color 200ms ease, transform 400ms var(--ease-out);
  }
  .toggle::before, .toggle::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 0.8rem; height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    translate: -50% -50%;
    transition: rotate 400ms var(--ease-out);
  }
  .toggle::after { rotate: 90deg; }
  details[open] .toggle { background: var(--green); color: var(--on-green); box-shadow: none; }
  details[open] .toggle::after { rotate: 0deg; }
  .answer { padding: 0 3.5rem 1.5rem 0; }
  .answer p { max-width: 36rem; }

  /* Smooth open/close where supported */
  @supports (interpolate-size: allow-keywords) {
    :root { interpolate-size: allow-keywords; }
    details::details-content {
      block-size: 0;
      overflow-y: clip;
      transition: block-size 450ms var(--ease-out), content-visibility 450ms allow-discrete;
    }
    details[open]::details-content { block-size: auto; }
  }

  @media (min-width: 60rem) {
    .grid { grid-template-columns: 1fr 1.5fr; gap: var(--space-3xl); }
    .head { position: sticky; top: calc(var(--header-h) + 2rem); }
  }
</style>

---
interface Props {
  tone?: 'ink' | 'paper';
  class?: string;
}
const { tone = 'ink', class: className } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`, className]}>
  <svg class="logo-mark" viewBox="4 14 56 40" aria-hidden="true">
    <path d="M4 18Q4 14 8 14H14Q18 14 18 18V27A14 14 0 0 0 46 27Q46 23 50 23H56Q60 23 60 27V34Q60 54 40 54H24Q4 54 4 34Z" />
    <circle cx="32" cy="27" r="10" />
  </svg>
  <span class="logo-type">
    <span class="logo-name">knockbox</span>
    <span class="logo-sub">studios</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--ink); }
  .logo-mark { width: 2.25rem; height: auto; fill: var(--green); flex: none; }
  .logo-type { display: grid; line-height: 1; }
  .logo-name {
    font-size: 1.3rem;
    font-weight: 760;
      letter-spacing: -0.045em;
  }
  .logo-sub {
    margin-top: 0.15rem;
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.42em;
    text-transform: lowercase;
  }
  .logo--paper { color: var(--on-green); }
  .logo--paper .logo-mark { fill: var(--on-green); }
</style>

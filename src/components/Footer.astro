---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { events, site } from '../data/events';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <a href="/" class="home" aria-label="Knockbox Studios home"><Logo tone="paper" /></a>
        <p>A smart photo booth for your next event. Good times, ready to share.</p>
      </div>

      <nav class="cols" aria-label="Footer">
        <div>
          <p class="col-title">Explore</p>
          <ul>
            <li><a href="/#how-it-works">How it works</a></li>
            <li><a href="/#features">The booth</a></li>
            <li><a href="/#faq">FAQ</a></li>
          </ul>
        </div>
        <div>
          <p class="col-title">Events</p>
          <ul>
            {events.map((e) => <li><a href={`/events/${e.slug}/`}>{e.title}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="col-title">Say hello</p>
          <ul>
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            <li>
              <a href={site.instagram.url} class="ig">
                <Icon name="instagram" />{site.instagram.handle}
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} Knockbox Studios</p>
      <p>Simple. Useful.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--green-deep);
    color: var(--on-green-soft);
    padding-bottom: var(--space-lg);
    font-size: var(--text-sm);
  }
  .top {
    display: grid;
    gap: var(--space-2xl);
    padding-top: clamp(2.5rem, 2rem + 2.5vw, 4rem);
    border-top: 1px solid rgb(243 239 227 / 0.14);
  }
  .home { display: inline-flex; text-decoration: none; }
  .brand p { margin-top: var(--space-md); max-width: 22rem; }
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xl) var(--space-lg); }
  .col-title {
    margin-bottom: var(--space-2xs);
    color: var(--on-green);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  ul { list-style: none; padding: 0; display: grid; }
  a { color: var(--on-green); text-decoration: none; overflow-wrap: anywhere; }
  li a { display: inline-flex; padding-block: 0.55rem; line-height: 1.3; }
  a:hover { text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: var(--clay); }
  a:focus-visible { outline-color: var(--on-green); }
  .ig { display: inline-flex; align-items: center; gap: 0.4rem; }
  .ig :global(svg) { width: 1.1rem; height: 1.1rem; }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-lg);
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-top: var(--space-lg);
    border-top: 1px solid rgb(243 239 227 / 0.14);
  }

  @media (min-width: 40rem) {
    .cols { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 60rem) {
    .top { grid-template-columns: 1fr 1.6fr; align-items: start; }
  }
</style>

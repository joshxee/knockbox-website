---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { EventStory } from '../data/events';

interface Props {
  event: EventStory;
  headingLevel?: 'h2' | 'h3';
}
const { event, headingLevel: H = 'h3' } = Astro.props;
const count = event.photos.length;
---
<a class="event-card" href={`/events/${event.slug}/`}>
  <div class="media">
    <Image
      src={event.cover.src}
      alt={event.cover.alt}
      widths={[360, 540, 720, 960]}
      sizes="(min-width: 60rem) 30vw, (min-width: 40rem) 45vw, 82vw"
    />
    <span class="kind">{event.kind}</span>
  </div>
  <div class="body">
    <H class="h3 title">{event.title}</H>
    <span class="meta">{count} photos <Icon name="arrow-up-right" /></span>
  </div>
</a>

<style>
  .event-card {
    display: grid;
    gap: var(--space-md);
    height: 100%;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .media { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--paper-deep); }
  .media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 900ms var(--ease-out);
  }
  .event-card:hover .media :global(img) { transform: scale(1.05); }
  .kind {
    position: absolute;
    left: var(--space-sm);
    top: var(--space-sm);
    padding: 0.35rem 0.75rem;
    border-radius: var(--pill);
    background: var(--paper);
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .body { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-md); padding-inline: 0.25rem; }
  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex: none;
    color: var(--ink-faint);
    font-size: var(--text-sm);
    white-space: nowrap;
  }
  .meta :global(svg) { width: 1rem; height: 1rem; transition: transform 300ms var(--ease-out), color 200ms ease; }
  .event-card:hover .meta :global(svg) { transform: translate(2px, -2px); color: var(--clay); }
</style>

---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { enquiryHref, site } from '../data/events';

const links = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#features', label: 'The booth' },
  { href: '/#events', label: 'Events' },
  { href: '/#faq', label: 'FAQ' },
];
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="home" href="/" aria-label="Knockbox Studios home">
      <Logo />
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="actions">
      <a class="btn btn--sm btn--green" href={enquiryHref}>Enquire</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="visually-hidden">Menu</span>
        <Icon name="menu" class="i-menu" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <nav class="wrap" aria-label="Mobile">
      <ul>
        {links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href}>{l.label}<Icon name="arrow-right" /></a>
          </li>
        ))}
      </ul>
      <div class="menu-foot">
        <a class="btn btn--green" href={enquiryHref}>Enquire now <Icon name="arrow-up-right" /></a>
        <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 82%, transparent);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 300ms ease, background-color 300ms ease;
  }
  .site-header.is-scrolled { border-bottom-color: var(--line); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    min-height: var(--header-h);
  }
  .home { display: inline-flex; text-decoration: none; border-radius: 6px; }
  .actions { display: flex; align-items: center; gap: 0.25rem; }
  .menu-toggle { margin-right: -0.5rem; }

  .nav { display: none; }
  .nav ul { display: flex; gap: clamp(1.25rem, 2.2vw, 2.25rem); list-style: none; padding: 0; }
  .nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 520;
    text-decoration: none;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0.2rem;
    height: 1.5px;
    background: var(--clay);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 350ms var(--ease-out);
  }
  .nav a:hover::after { transform: scaleX(1); transform-origin: left; }

  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
  }
  .menu-toggle :global(svg) { grid-area: 1 / 1; width: 1.4rem; height: 1.4rem; transition: opacity 200ms ease, transform 300ms var(--ease-out); }
  .menu-toggle :global(.i-close) { opacity: 0; transform: rotate(-45deg); }
  .menu-toggle[aria-expanded='true'] :global(.i-menu) { opacity: 0; transform: rotate(45deg); }
  .menu-toggle[aria-expanded='true'] :global(.i-close) { opacity: 1; transform: none; }

  .mobile-menu {
    border-top: 1px solid var(--line);
    background: var(--paper);
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }
  .mobile-menu ul { list-style: none; padding: var(--space-md) 0 var(--space-xl); }
  .menu-foot { display: grid; gap: var(--space-md); justify-items: start; padding-bottom: var(--space-2xl); animation: menu-in 500ms var(--ease-out) 220ms both; }
  .menu-foot .btn { width: 100%; }
  .menu-foot .text-link { padding-block: 0.5rem; }
  .mobile-menu li {
    border-bottom: 1px solid var(--line);
    animation: menu-in 500ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms);
  }
  .mobile-menu a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.1rem;
    color: var(--ink);
    font-size: var(--text-xl);
    font-weight: 620;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .mobile-menu a :global(svg) { width: 1.4rem; height: 1.4rem; color: var(--clay); }
  @keyframes menu-in { from { opacity: 0; transform: translateY(0.75rem); } }

  @media (min-width: 60rem) {
    .nav { display: block; }
    .menu-toggle, .mobile-menu { display: none !important; }
    .bar { display: grid; grid-template-columns: 1fr auto 1fr; }
    .actions { justify-self: end; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (header) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.style.overflow = open ? 'hidden' : '';
      // Keep keyboard and screen-reader focus inside the open menu.
      document.querySelectorAll<HTMLElement>('main, footer, .site-header .home, .site-header .actions > .btn').forEach((el) => {
        el.inert = open;
      });
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));
  }
</script>

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the deployed Worker, so production deploys keep targeting it.
  "name": "knockbox-website",
  "compatibility_date": "2026-10-19",
  // Build the Astro site before every deploy or preview upload, so dist/ exists
  // whatever the build command in the Cloudflare dashboard is set to.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html for unknown paths.
    "not_found_handling": "404-page"
  },
  // Preview URLs for branch builds (Workers Builds runs `npx wrangler preview`).
  "preview_urls": true,
  // Required by `wrangler preview`. Empty: previews use the top-level settings (a static site has no bindings).
  "previews": {}
}
